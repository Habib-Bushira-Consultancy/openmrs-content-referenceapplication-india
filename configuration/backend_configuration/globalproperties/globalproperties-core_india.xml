<config>
    <globalProperties>
        <globalProperty>
            <property>referencedemodata.createDemoPatientsOnNextStartup</property>
            <value>50</value>
        </globalProperty>
        <!-- Queue Configuration -->

        <!-- https://app.openconceptlab.org/#/orgs/HISP/sources/HISPIndia-Queue-Concepts/ -->
        <globalProperty>
            <property>queue.serviceConceptSetName</property>
            <value>665eb034-e055-44ba-b506-40529eadaab0</value>
        </globalProperty>

        <!-- https://app.openconceptlab.org/#/orgs/openmrs/sources/DemoQueueConcepts/concepts/DemoQueue-Priority/ -->
        <globalProperty>
            <property>queue.priorityConceptSetName</property>
            <value>78063dec-b6d8-40c1-9483-dd4d3c3ca434</value>
        </globalProperty>

        <!-- HISP India status set: Waiting, In Service, Finished Service, Patient Not Available, Consultation Cancelled (concepts/queue_statuses-core_india.csv) -->
        <globalProperty>
            <property>queue.statusConceptSetName</property>
            <value>f270a532-91d2-5d23-b58c-ce157cd4dbca</value>
        </globalProperty>

        <!-- This requires that the sort weight for priority concepts be maintained in order of least to most urgent -->
        <globalProperty>
            <property>queue.sortWeightGenerator</property>
            <value>basicPrioritySortWeightGenerator</value>
        </globalProperty>

        <!-- Queue module 3.1+: end every open queue entry once a day at this time (HH:mm, server local time),
             so each queue starts the day empty. A patient back the next day on the same open visit is re-queued. -->
        <globalProperty>
            <property>queue.autoCloseQueueEntriesAtTime</property>
            <value>23:59</value>
        </globalProperty>

        <!-- Queues cleared at that time: comma-separated queue names or uuids; empty = all queues -->
        <globalProperty>
            <property>queue.autoCloseQueueEntriesForQueues</property>
            <value></value>
        </globalProperty>

        <!-- Visit auto-close: EMR API "Close Stale Visits" task closes visits with no activity (no new encounter)
             for this many hours. 240 h = 10 days. Needs the task org.openmrs.module.emrapi.adt.CloseStaleVisitsTask
             scheduled once per server (Manage Scheduler). Closing a visit also ends its open queue entries. -->
        <globalProperty>
            <property>emrapi.visitExpireHours</property>
            <value>240</value>
        </globalProperty>

        <globalProperty>
            <property>concept.causeOfDeath</property>
            <value>9272a14b-7260-4353-9e5b-5787b5dead9d</value>
        </globalProperty>

        <globalProperty>
            <property>attachments.allowedFileExtensions</property>
            <value>jpeg,jpg,png,pdf</value>
        </globalProperty>
    </globalProperties>
</config>
